{
  "id": "latex",
  "name": "LaTeX",
  "version": "2.0.0",
  "description": "Overleaf-style LaTeX editor: a VSCode-like file drawer, a real tectonic PDF build, and an embedded agent that writes your .tex for you.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-latex",
  "entry": "index.jsx",
  "icon": "icon.png",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "storage_seeds": {
    "files/welcome.tex": "files/welcome.tex",
    "chat_id.json": null,
    "files-index.json": [
      "files/welcome.tex"
    ]
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom"
    ],
    "esm_deps": [
      "katex",
      "dompurify"
    ]
  },
  "schedule": {
    "job": "build.sh",
    "default": "0 0 1 1 *"
  }
}