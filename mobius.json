{
  "id": "latex",
  "name": "LaTeX",
  "version": "2.1.5",
  "description": "Overleaf-style LaTeX editor: a VSCode-like side file drawer, a real in-app PDF viewer (pdf.js), a Source/PDF toggle, a settable main document, and an embedded agent that writes your .tex for you.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-latex",
  "entry": "index.jsx",
  "icon": "icon.png",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "read"
  },
  "storage_seeds": {
    "files/welcome.tex": "files/welcome.tex",
    "chat_id.json": null,
    "files-index.json": [
      "files/welcome.tex"
    ]
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "pdfjs-dist"
    ],
    "esm_deps": []
  },
  "schedule": {
    "job": "build.sh"
  }
}
