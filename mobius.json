{
  "id": "latex",
  "name": "LaTeX",
  "version": "2.13.4",
  "description": "Write and compile LaTeX with live PDF preview and an agent that drafts your .tex.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-latex",
  "entry": "index.jsx",
  "icon": "icon.png",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "read"
  },
  "storage_seeds": {
    "files/welcome.tex": "files/welcome.tex",
    "chat_id.json": null,
    "files-index.json": [
      "files/welcome.tex"
    ]
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "pdfjs-dist",
      "@codemirror/state",
      "@codemirror/view",
      "@codemirror/commands",
      "@codemirror/language"
    ],
    "esm_deps": []
  },
  "offline": {
    "reads": true,
    "writes": "queued",
    "execution": "none"
  },
  "schedule": {
    "job": "build.sh"
  },
  "embeds_agent": true
}
