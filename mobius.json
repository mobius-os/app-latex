{
  "id": "latex",
  "name": "LaTeX",
  "version": "3.0.2",
  "description": "A Project app for LaTeX documents and PDF Creations.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-latex",
  "entry": "index.jsx",
  "source_files": [
    "latex-project.md",
    "project-builder.sh",
    "templates/main.tex",
    "latest-request.js"
  ],
  "icon": "icon.png",
  "offline_capable": false,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "read"
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "@openai/apps-sdk-ui/components/Icon"
    ],
    "esm_deps": []
  },
  "offline": {
    "reads": false,
    "writes": "none",
    "execution": "none"
  },
  "embeds_agent": false,
  "skills": [
    "latex-project.md"
  ],
  "project_templates": [
    {
      "id": "document",
      "name": "LaTeX document",
      "description": "Write source with project chats and compile it into a PDF Creation.",
      "guidance": "Work directly inside the project root. Keep LaTeX source and local assets together, and build the root .tex file as a PDF Creation.",
      "skills": [
        "latex-project.md"
      ],
      "dependencies": [
        "tectonic"
      ],
      "files": {
        "main.tex": "templates/main.tex"
      },
      "previews": [
        {
          "id": "document",
          "name": "Document",
          "source": "main.tex",
          "builder": "latex"
        }
      ],
      "artifact_types": [
        {
          "id": "latex",
          "name": "PDF",
          "extensions": [
            "tex"
          ],
          "preview": "pdf",
          "script": "project-builder.sh",
          "output": "{stem}.pdf"
        }
      ],
      "kind": "latex"
    }
  ]
}
